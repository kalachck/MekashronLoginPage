@page "/"
@using MekashronLoginPage.Application
@inject IAuthorizationProvider AuthorizationProvider

<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title text-center mb-4">Sign in</h3>
                        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label for="login" class="form-label">Username</label>
                                <InputText id="login" class="form-control" @bind-Value="loginModel.Username" />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Enter</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast for  -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        <div class="toast align-items-center text-white @toastClass border-0 show" role="alert" aria-live="assertive" aria-atomic="true" @ref="toastRef" style="display:@(showToast ? "flex" : "none")">
            <div class="d-flex">
                <div class="toast-body">
                    @toastMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" @onclick="() => showToast = false"></button>
            </div>
        </div>
    </div>
</body>

@code {
    private LoginModel loginModel = new();
    private bool showToast = false;
    private string toastMessage = "";
    private string toastClass = "bg-success";
    private ElementReference toastRef;

    private async Task HandleLogin()
    {
        var isAuthorized = await AuthorizationProvider.LoginAsync(loginModel.Username, loginModel.Password);

        if (isAuthorized)
        {
            toastClass = "bg-success";
            toastMessage = "Login successful!";
        }
        else
        {
            toastClass = "bg-danger";
            toastMessage = "Login failed!";
        }

        showToast = true;

        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }

    public class LoginModel
    {
        public string Username { get; set; } = null!;
        public string Password { get; set; } = null!;
    }
}
