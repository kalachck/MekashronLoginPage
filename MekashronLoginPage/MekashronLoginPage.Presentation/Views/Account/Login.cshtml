@using MekashronLoginPage.Application.Dtos
@model MekashronLoginPage.Presentation.Models.LoginViewModel

@{
Layout = null;
var loginResponse = ViewBag.LoginResponse as LoginResponseDto;
var showToast = ViewBag.ShowToast ?? false;
var toastMessage = ViewBag.ToastMessage ?? "";
var toastClass = ViewBag.ToastClass ?? "bg-success";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sign in page for Mekashron. Enter your credentials to access your account.">
    <title>Sign In</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>

    <style>
        body {
             background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab); 
             background-size: 400% 400%; 
             animation: GradientAnimation 15s ease infinite; 

             @@keyframes GradientAnimation { 
             0% { background-position: 0% 50%; } 
             50% { background-position: 100% 50%; } 
             100% { background-position: 0% 50%; } 
             } 

            min-height: 100vh;
            display: flex;
            flex-direction: column; 
        }

        .login-form {
            padding: 2.5rem;
            border-radius: 1rem;
            border: none;
            background-color: rgba(255, 255, 255, 0.9);
        }

        .text-center.mb-4 i {
            color: #fff !important;
            text-shadow: 0 0 10px rgba(0,0,0,0.2);
        }
        
        .toast-custom {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 0.75rem;
        }
        
        .toast-custom .login-response {
            background-color: rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .toast-custom .table-primary {
            background-color: var(--bs-primary) !important; /* !important для переопределения */
            color: white !important;
        }
    </style>
</head>
<body>
<main class="flex-grow-1 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-lg login-form">
                    <div class="card-body">
                        <h3 class="card-title text-center mb-4">Sign in</h3>
                        <form asp-action="Login" method="post">

                            <div class="form-floating mb-3">
                                <input type="text" id="Username" name="Username" class="form-control" value="@Model.Username" placeholder="Username" required/>
                                <label for="Username">Username</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="password" id="Password" name="Password" class="form-control" value="@Model.Password" placeholder="Password" required/>
                                <label for="Password">Password</label>
                            </div>

                            <div class="mb-3 text-end">
                                <a href="#" class="text-decoration-none small">Forgot password?</a>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">Enter</button>
                            </div>
                        </form>

                        <hr class="my-4">
                        <div class="text-center">
                            <p class="mb-0">Don't have an account?</p>
                            <a href="#" class="fw-bold text-decoration-none">Sign Up</a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        <div class="toast align-items-start text-dark toast-custom border-0 show shadow-lg"
             role="alert" aria-live="assertive" aria-atomic="true"
             style="display:@(showToast ? "flex" : "none"); min-width: 320px;">
            @Html.Partial("_ToastContent", loginResponse)
        </div>
    </div>

</main>
</body>
</html>
